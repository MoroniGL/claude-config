# ============================================================
# Credenciais e tokens - NUNCA commitar
# ============================================================
.credentials.json
.env
.env.*
*credentials*
*secret*
*.key
*.pem

# ============================================================
# Estado local da sessao (auto-gerado por Claude Code)
# ============================================================
.last-cleanup
history.jsonl
stats-cache.json
mcp-needs-auth-cache.json
vercel-plugin-device-id
vercel-plugin-telemetry-preference

# ============================================================
# Caches e diretorios locais (~/.claude/)
# ============================================================
cache/
chrome/
downloads/
file-history/
ide/
paste-cache/
session-env/
sessions/
shell-snapshots/
telemetry/
projects/
backups/

# ============================================================
# Plugins baixados (~1.1GB) - restaurados via scripts/restore
# ============================================================
plugins/cache/
plugins/marketplaces/
plugins/data/
plugins/install-counts-cache.json
plugins/blocklist.json
plugins/installed_plugins.json.bak

# ============================================================
# local-bin/ - itens que NAO devem entrar no backup
# ============================================================

# Worktrees temporarios do claude-flow (~1.5GB)
local-bin/.claude/worktrees/

# Banco de memoria local (binary, regenerado)
local-bin/.claude/memory.db
local-bin/.claude/memory.db-*

# .swarm e .playwright-mcp (estado local)
local-bin/.swarm/
local-bin/.playwright-mcp/

# Outputs gerados (graphify, carousels)
local-bin/graphify-out/
local-bin/.graphify_*
local-bin/carousel-output/
local-bin/C:Usersmoron.localbincarousel-output/

# Memoria persistente (privada)
local-bin/memory/

# Executaveis e binarios grandes
local-bin/claude.exe
local-bin/*.zip
local-bin/*.rar
local-bin/*.tar.gz

# Atalhos do Windows
local-bin/*.lnk

# Pastas de projetos pessoais (NAO sao parte do Claude Code)
local-bin/3d brand/
local-bin/Advogado uk/
local-bin/aios-core/
local-bin/chronos-bot/
local-bin/claude/
local-bin/claude-cookbooks/
